#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Dvorak {
            bindings = <
&kp ESC    &kp N1            &kp N2     &kp N3        &kp N4        &kp N5            &kp N6         &kp N7     &kp N8  &kp N9  &kp N0  &mo 2
&kp TAB    &kp SINGLE_QUOTE  &kp COMMA  &kp PERIOD    &kp P         &kp Y             &kp F          &kp G      &kp C   &kp R   &kp L   &kp BSLH
&kp ESC    &kp A             &lt 4 O    &kp E         &lt 3 U       &kp I             &kp D          &kp H      &kp T   &kp N   &kp S   &kp RCTRL
&kp LCTRL  &kp SEMICOLON     &kp Q      &kp J         &kp K         &mt LEFT_ALT X    &kp B          &kp M      &kp W   &kp V   &kp Z   &mo 1
                                        &lt 1 DELETE  &kp SPACE     &mt LCTRL TAB     &kp BACKSPACE  &kp ENTER
                                                      &kp LEFT_WIN  &kp LEFT_SHIFT    &mo 5
            >;
        };

        F_layers {
            bindings = <
&kp F1  &kp F2  &kp F3     &kp F4         &kp F5             &kp F6           &kp F7        &kp F8     &kp F9        &kp F10      &kp F11    &kp F12
&trans  &none   &none      &none          &none              &trans           &none         &kp AMPS   &kp ASTERISK  &none        &none      &kp EQUAL
&trans  &none   &kp MINUS  &kp LS(UNDER)  &kp LC(PAGE_UP)    &kp LS(COLON)    &kp LS(EXCL)  &kp HASH   &kp DOLLAR    &kp PERCENT  &kp CARET  &trans
&trans  &trans  &kp EQUAL  &kp LS(PLUS)   &kp LC(PAGE_DOWN)  &kp SEMI         &kp LS(AT)    &mkp LCLK  &mkp RCLK     &trans       &none      &trans
                           &trans         &trans             &To0_macro       &mkp LCLK     &mkp RCLK
                                          &trans             &trans           &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };

        Symbols_1 {
            bindings = <
&trans  &trans      &trans      &trans          &trans           &trans           &trans           &trans     &trans        &trans         &trans     &trans
&trans  &kp LS(LT)  &kp LS(GT)  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans           &kp PRINTSCREEN  &kp HOME   &kp UP_ARROW  &kp PAGE_UP    &kp END    &trans
&trans  &kp LBKT    &kp RBKT    &kp LS(LPAR)    &kp LS(RPAR)     &kp GRAVE        &kp SQT          &kp LEFT   &kp DOWN      &kp PAGE_DOWN  &kp RIGHT  &trans
&trans  &trans      &kp Q       &kp LS(COLON)   &kp SEMI         &kp LS(TILDE)    &kp LS(DQT)      &kp SLASH  &kp QUESTION  &kp BACKSLASH  &kp PIPE   &trans
                                &trans          &trans           &trans           &trans           &trans
                                                &trans           &trans           &trans
            >;
        };
    };
};
